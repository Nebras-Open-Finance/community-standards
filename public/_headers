# Cloudflare Pages response headers. Anything not matched here gets the Pages
# default (revalidate on every request via ETag).

# Vite fingerprints every file it emits under /assets/ — JS, CSS, and the
# /metrics usage summaries from scripts/build-metrics.mjs — so a changed file
# always gets a new URL and a cached copy can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The API log shards are requested as /api/<shard>?v=<content hash>, from the
# manifest scripts/encode-api-log.mjs writes, so they are safe to cache the
# same way. The manifest (api-log-index.json) is not matched and revalidates.
/api/api-log-q*
  Cache-Control: public, max-age=31536000, immutable
